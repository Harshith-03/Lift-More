# Copy to .env and fill in. Never commit .env.

# Google Gemini (AI coach). Leave empty to run without AI — rule-based plans still work.
GEMINI_API_KEY=
# Model id. On 404/overload/timeout the server falls back: gemini-3.5-flash -> gemini-3.1-flash-lite -> gemini-flash-lite-latest -> gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash
# Your key's per-minute quota. The server enforces this globally across all users.
GEMINI_RPM=15
# Per-user cap on AI calls per day.
GEMINI_USER_DAILY_LIMIT=30

# Postgres connection string (e.g. Neon). Leave empty locally to use an embedded PGlite DB in ./.data/
DATABASE_URL=

PORT=3001
NODE_ENV=development
# Public origin in production, used for the CSRF Origin check (e.g. https://lift-more.onrender.com)
APP_ORIGIN=
